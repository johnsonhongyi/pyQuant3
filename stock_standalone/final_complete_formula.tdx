{========================
  核心均线与BOLL布林线 (优先置顶显示)
=========================}
MA5:MA(CLOSE,5),COLORYELLOW,LINETHICK2;
MA60:EMA(CLOSE,60),LINETHICK2,DOTLINE,COLORCYAN;
BOLL:MA(CLOSE,20),COLORWHITE,LINETHICK1;
UB:BOLL+2*STD(CLOSE,20),COLORYELLOW,LINETHICK1;
LB:BOLL-2*STD(CLOSE,20),COLORMAGENTA,LINETHICK1;

{==================== TD神奇九转（全角大字号与上移悬浮优化） ====================}
JZ_M:=9;
JZ_N:=JZ_M-1;
JZ_OFS:=0.038; {垂直悬浮间距比例: 0.038让数字远离K线完全上移/下移，可按需微调}

JZ_UP1:=C>REF(C,4);
JZ_UP2:=BARSLASTCOUNT(JZ_UP1);
JZ_UP3:=REF(JZ_UP2,1)=JZ_N AND JZ_UP2>REF(JZ_UP2,1);
JZ_UP4:=REF(BETWEEN(JZ_UP2,5,JZ_N),1) AND JZ_UP2<REF(JZ_UP2,1);
JZ_UP5:=ISLASTBAR AND BETWEEN(JZ_UP2,6,JZ_N);

JZ_UP6:=(BACKSET(JZ_UP3>0,JZ_N+1) OR BACKSET(JZ_UP4>0,JZ_UP2+1)*0 OR BACKSET(JZ_UP5>0,JZ_UP2))*JZ_UP2;
JZ_UP_TXT:=IF(JZ_UP6=1,'１',IF(JZ_UP6=2,'２',IF(JZ_UP6=3,'３',IF(JZ_UP6=4,'４',IF(JZ_UP6=5,'５',IF(JZ_UP6=6,'６',IF(JZ_UP6=7,'７',IF(JZ_UP6=8,'８',''))))))));

{上升序列1~8采用全角大字符，位置上移至最高价上方JZ_OFS比例}
DRAWTEXT(JZ_UP6>0 AND JZ_UP6<9, H*(1+JZ_OFS), JZ_UP_TXT), COLORYELLOW;
{上升序列第9根关键转折大字符，避免重叠并突出显示}
DRAWTEXT(JZ_UP2=JZ_N+1, H*(1+JZ_OFS), ' ９ '), COLOR00FF00;

JZ_DN1:=C<REF(C,4);
JZ_DN2:=BARSLASTCOUNT(JZ_DN1);
JZ_DN3:=REF(JZ_DN2,1)=JZ_N AND JZ_DN2>REF(JZ_DN2,1);
JZ_DN4:=REF(BETWEEN(JZ_DN2,5,JZ_N),1) AND JZ_DN2<REF(JZ_DN2,1);
JZ_DN5:=ISLASTBAR AND BETWEEN(JZ_DN2,6,JZ_N);

JZ_DN6:=(BACKSET(JZ_DN3>0,JZ_N+1) OR BACKSET(JZ_DN4>0,JZ_DN2+1)*0 OR BACKSET(JZ_DN5>0,JZ_DN2))*JZ_DN2;
JZ_DN_TXT:=IF(JZ_DN6=1,'１',IF(JZ_DN6=2,'２',IF(JZ_DN6=3,'３',IF(JZ_DN6=4,'４',IF(JZ_DN6=5,'５',IF(JZ_DN6=6,'６',IF(JZ_DN6=7,'７',IF(JZ_DN6=8,'８',''))))))));

{下降序列1~8采用全角大字符，位置下移至最低价下方JZ_OFS比例}
DRAWTEXT(JZ_DN6>0 AND JZ_DN6<9, L*(1-JZ_OFS), JZ_DN_TXT), COLOR00FF00;
{下降序列第9根关键转折大字符，避免重叠并突出显示}
DRAWTEXT(JZ_DN2=JZ_N+1, L*(1-JZ_OFS), ' ９ '), COLORYELLOW;

{无DLL计算}
N1:=10;
N2:=10;
DISP:=2;

ZSK:=1/10;

ZSP1:=PEAK(1,ZSK*N1,1);
ZSP2:=PEAK(1,ZSK*N1,2);

ZST1:=TROUGH(2,ZSK*N2,1);
ZST2:=TROUGH(2,ZSK*N2,2);

ZSTJ1:=ZSP1>ZST1 AND ZSP2>ZST2;

ZSZD:=MAX(ZST1,ZST2);
ZSZG:=MIN(ZSP1,ZSP2);

ZSLL:=MIN(ZST1,ZST2);
ZSHH:=MAX(ZSP1,ZSP2);

ZSTJ2:=FILTER(ZSZG>ZSZD,2);

ZSTJ3:=ZSZG=REF(ZSZG,BARSLAST(ZSTJ2))
   OR ZSZD=REF(ZSZD,BARSLAST(ZSTJ2));

ZSTJ4:=ZSTJ1&&ZSTJ2&&NOT(ZSTJ3);

ZSTJ5:=BETWEEN(ZSZD,
REF(ZSZD,REF(BARSLAST(ZSTJ4),1)),
REF(ZSZG,REF(BARSLAST(ZSTJ4),1)));

ZSTJ6:=BETWEEN(ZSZG,
REF(ZSZD,REF(BARSLAST(ZSTJ4),1)),
REF(ZSZG,REF(BARSLAST(ZSTJ4),1)));

ZSTJ7:=ZSZG>REF(ZSZG,REF(BARSLAST(ZSTJ4),1))
&&ZSZD<REF(ZSZD,REF(BARSLAST(ZSTJ4),1));

ZSTJ8:=ZSTJ4&&NOT(ZSTJ5 OR ZSTJ6 OR ZSTJ7);

ZSZSD:=IF(ZSTJ8,ZSZD,DRAWNULL);
ZSZSG:=IF(ZSTJ8,ZSZG,DRAWNULL);
ZSZSH:=IF(ZSTJ8,ZSHH,DRAWNULL);
ZSZSL:=IF(ZSTJ8,ZSLL,DRAWNULL);

STICKLINE(ZSTJ8,ZSZSH,ZSZSL,0,-1),COLORMAGENTA;
STICKLINE(ZSTJ8,ZSZSD,ZSZSG,IF(DISP=1,3,0),1),COLORMAGENTA;

DRAWTEXT(DISP=2,ZSZSH,'中枢'),COLORRED;

中枢高:PLOYLINE(DISP=2,REF(ZSZSD,BARSLAST(ZSTJ8))),CROSSDOT,COLORLIRED;
中枢低:PLOYLINE(DISP=2,REF(ZSZSG,BARSLAST(ZSTJ8))),CROSSDOT,COLORLIGREEN;
中枢最高:PLOYLINE(DISP=2,REF(ZSZSH,BARSLAST(ZSTJ8))),POINTDOT,COLORRED;
中枢最低:PLOYLINE(DISP=2,REF(ZSZSL,BARSLAST(ZSTJ8))),POINTDOT,COLORGREEN;

{========================
  高低点价格显示
=========================}

ZS_HD1:=FILTER(
BACKSET(
FILTER(
REF(H,10)=HHV(H,21),
10
),
11
),
10
);


ZS_LD1:=FILTER(
BACKSET(
FILTER(
REF(L,10)=LLV(L,21),
10
),
11
),
10
);


DRAWNUMBER(
ZS_HD1,
H*1.03,
H
),
COLORWHITE;


DRAWNUMBER(
ZS_LD1,
L*0.97,
L
),
COLORWHITE;

{绑定为6号函数}
BI:=TDXDLL6(2,H,L,0);

{笔中枢}
BIZG:=TDXDLL6(5,BI,H,L);
BIZD:=TDXDLL6(7,BI,H,L);
BISE:=TDXDLL6(9,BI,H,L);
BIMID:=(BIZG-BIZD)/2+BIZD;

BIZG线:IF(BIZG,BIZG,DRAWNULL),LINETHICK3,COLORGREEN;
BIZD线:IF(BIZD,BIZD,DRAWNULL),LINETHICK3,COLORGREEN;
BI中枢:STICKLINE(BISE,BIZD,BIZG,0,0),LINETHICK3,COLORGREEN;
BIMID线:IF(BIMID,BIMID,DRAWNULL),LINETHICK2,COLORBLUE;


{段中枢}
DUAN:=TDXDLL6(3,BI,H,L);

DUANZG:=TDXDLL6(5,DUAN,H,L);
DUANZD:=TDXDLL6(7,DUAN,H,L);
DUANSE:=TDXDLL6(9,DUAN,H,L);
DUANMID:=(DUANZG-DUANZD)/2+DUANZD;

DUANZG线:IF(DUANZG,DUANZG,DRAWNULL),LINETHICK2,COLORFF8000;
DUANZD线:IF(DUANZD,DUANZD,DRAWNULL),LINETHICK2,COLORFF8000;
DUAN中枢:STICKLINE(DUANSE,DUANZD,DUANZG,0,0),LINETHICK2,COLORFF8000;
DUANMID线:IF(DUANMID,DUANMID,DRAWNULL),LINETHICK2,COLORMAGENTA;




TC1:=IF(H=HHV(H,8*UR),H,DRAWNULL);
TC2:=CONST(BARSLAST(TC1=H))+1;
UPPER:=CONST(IF(TC2=1,H,REF(H,TC2-1)));
BC1:=IF(L=LLV(L,8*LR),L,DRAWNULL);
BC2:=CONST(BARSLAST(BC1=L))+1;
LOWER:=CONST(IF(BC2=1,L,REF(L,BC2-1)));
LP:=CURRBARSCOUNT<=BC2 AND L=LOWER;{低点定位}
HP:=CURRBARSCOUNT<=TC2 AND H=UPPER;{高点定位}
STICKLINE(IF(BC2>TC2,HP,LP),LOWER,UPPER,0,0),COLOR628962;
STICKLINE(IF(BC2>TC2,LP,HP),LOWER,UPPER,0,0),COLOR628962;

NOD:=(IF(TC2>BC2,TC2,BC2)-IF(TC2>BC2,BC2,TC2));{用时}

LR1:=FORCAST(C,NOD+1);
NP:IF(CURRBARSCOUNT<=MAX(BC2,TC2),CONST(IF(MIN(TC2,BC2)=1,LR1,REF(LR1,MIN(TC2,BC2)-1))),DRAWNULL),COLORGREEN,LINETHICK1;{近点}
LR2:=SLOPE(C,NOD+1);
LR3:=CONST(IF(MIN(TC2,BC2)=1,LR2,REF(LR2,MIN(TC2,BC2)-1)));
FP:NP-LR3*(NOD),COLORRED;{远点}
EQU:(NP+FP)/2,COLOR93BDA8;

AD:=ABS(NP-FP);{高差};
DBL:=BARSLAST(BC1!=DRAWNULL)+1;
DBH:=BARSLAST(TC1!=DRAWNULL)+1;
BSP:=IF(BC2>TC2,DBL,DBH)-1;

LRL:=IF(NP>FP,FP+AD/NOD*BSP,FP-AD/NOD*BSP);
AT1:=IF(BETWEEN(CURRBARSCOUNT,BC2,TC2) AND H>LRL,H,LRL);
AT2:=HHV(AT1-LRL,MAX(BC2,TC2));
AT3:=CONST(BARSLAST(AT1-LRL=AT2));
AT4:=CONST(IF(AT3=0,H,REF(H,AT3)));
AT5:=CONST(IF(AT3=0,AT1-LRL,REF(AT1-LRL,AT3)));
ATL:=LRL+AT5;

UT1:=IF(BETWEEN(CURRBARSCOUNT,BC2,TC2) AND L<LRL,L,LRL);
UT2:=HHV(LRL-UT1,MAX(BC2,TC2));
UT3:=CONST(BARSLAST(LRL-UT1=UT2));
UT4:=CONST(IF(UT3=0,H,REF(H,UT3)));
UT5:=CONST(IF(UT3=0,LRL-UT1,REF(LRL-UT1,UT3)));
UTL:=LRL-UT5;

{限制高与限制低: 截断过长斜线}
END_BAR:=CONST(MIN(BC2,TC2));
END_H:=CONST(HHV(H,END_BAR));
END_L:=CONST(LLV(L,END_BAR));
MAX_H:=CONST(MAX(UPPER,END_H));
MIN_L:=CONST(MIN(LOWER,END_L));

RH:=MAX_H*1.10;{限制高: 最高价10%}
RL:=MIN_L*0.90;{限制低: 最近通道结束后的最低价10%}

中轨:IF(LRL<=RH AND LRL>=RL,LRL,DRAWNULL),COLORWHITE,LINETHICK2;
上轨:IF(ATL<=RH AND ATL>=RL,ATL,DRAWNULL),COLORWHITE,LINETHICK1;
下轨:IF(UTL<=RH AND UTL>=RL,UTL,DRAWNULL),COLORWHITE,LINETHICK1;


HH:=(20*H+19*REF(H,1)+18*REF(H,2)+17*REF(H,3)+16*REF(H,4)+15*REF(H,5)+14*REF(H,6)
+13*REF(H,7)+12*REF(H,8)+11*REF(H,9)+10*REF(H,10)+9*REF(H,11)+8*REF(H,12)
+7*REF(H,13)+6*REF(H,14)+5*REF(H,15)+4*REF(H,16)+3*REF(H,17)+2*REF(H,18)+
REF(H,20))/210,COLORBLUE,LINETHICK1;
LL:=(20*L+19*REF(L,1)+18*REF(L,2)+17*REF(L,3)+16*REF(L,4)+15*REF(L,5)+14*REF(L,6)
+13*REF(L,7)+12*REF(L,8)+11*REF(L,9)+10*REF(L,10)+9*REF(H,11)+8*REF(H,12)
+7*REF(L,13)+6*REF(L,14)+5*REF(L,15)+4*REF(L,16)+3*REF(H,17)+2*REF(L,18)+
REF(L,20))/210,COLORBLUE,LINETHICK1;
GO0B:=(XMA(XMA(H,60),60)-XMA(XMA(L,60),60))*3+XMA(XMA(H,60),60);
DO0B:=XMA(XMA(L,60),60)-(XMA(XMA(H,60),60)-XMA(XMA(L,60),60))*3;
{STICKLINE(1=1,GO0B,DO0B,5,0),COLOR222222;}
D90H:=EMA(HH,90),COLORRED,LINETHICK1;
D90L:=EMA(LL,90),COLORRED,LINETHICK1;
D90:(D90H+D90L)/2;
DGH:=(20*H+19*REF(H,1)+18*REF(H,2)+17*REF(H,3)+16*REF(H,4)+15*REF(H,5)+14*REF(H,6)
+13*REF(H,7)+12*REF(H,8)+11*REF(H,9)+10*REF(H,10)+9*REF(H,11)+8*REF(H,12)
+7*REF(H,13)+6*REF(H,14)+5*REF(H,15)+4*REF(H,16)+3*REF(H,17)+2*REF(H,18)+
REF(H,20))/210,COLORBLUE,LINETHICK1;DDL:=(20*L+19*REF(L,1)+18*REF(L,2)+17*REF(L,3)+16*REF(L,4)+15*REF(L,5)+14*REF(L,6)
+13*REF(L,7)+12*REF(L,8)+11*REF(L,9)+10*REF(L,10)+9*REF(H,11)+8*REF(H,12)
+7*REF(L,13)+6*REF(L,14)+5*REF(L,15)+4*REF(L,16)+3*REF(H,17)+2*REF(L,18)+
REF(L,20))/210,COLORBLUE,LINETHICK1;
D90C:=D90H-D90L;
G0:=(XMA(XMA(H,25),25)-XMA(XMA(L,25),25))+XMA(XMA(H,25),25);
D0:=XMA(XMA(L,25),25)-(XMA(XMA(H,25),25)-XMA(XMA(L,25),25));
GO0:=(XMA(XMA(H,60),60)-XMA(XMA(L,60),60))*3+XMA(XMA(H,60),60);
DO0:=XMA(XMA(L,60),60)-(XMA(XMA(H,60),60)-XMA(XMA(L,60),60))*3;
DTD:=(D0+G0)/2>=(D90H+D90L)/2;
KTD:=(D0+G0)/2<(D90H+D90L)/2;
YM:EMA(SLOPE((CLOSE+HIGH+LOW)/3,24)*20+(CLOSE+HIGH+LOW)/3,48),COLORWHITE,LINETHICK1;
YM1:EMA(YM,5),COLORWHITE,LINETHICK1;
YM2:EMA(YM1,5),COLORWHITE,LINETHICK1;
YM3:EMA(YM2,5),COLORWHITE,LINETHICK1;
D1:EMA(D90,10),COLORWHITE,LINETHICK1;
D2:EMA(D1,10),COLORWHITE,LINETHICK1;
DRAWTEXT(CROSS(ZIG(3,10),REF(ZIG(3,10),1)),L*0.99,'买'),COLORRED;
DRAWTEXT(CROSS(REF(ZIG(3,10),1),ZIG(3,10)),H*1.01,'卖'),COLORGREEN;
IF(DTD=1,YM,DRAWNULL),LINETHICK1,COLORRED;
IF(DTD=1,YM1,DRAWNULL),LINETHICK1,COLORRED;
IF(DTD=1,YM2,DRAWNULL),LINETHICK1,COLORRED;
IF(DTD=1,YM3,DRAWNULL),LINETHICK1,COLORRED;
IF(KTD=1,YM,DRAWNULL),LINETHICK1,COLORGREEN;
IF(KTD=1,YM1,DRAWNULL),LINETHICK1,COLORGREEN;
IF(KTD=1,YM2,DRAWNULL),LINETHICK1,COLORGREEN;
IF(KTD=1,YM3,DRAWNULL),LINETHICK1,COLORGREEN;
IF(D90>D1,D90,DRAWNULL),LINETHICK1,COLORRED;
IF(D90>D1,D1,DRAWNULL),LINETHICK1,COLORRED;
IF(D90>D1,D2,DRAWNULL),LINETHICK1,COLORRED;

DX0:=DRAWLINE(HIGH>=HHV(HIGH,20),HIGH,LOW<=LLV(LOW,20),HHV(HIGH,4),1);
KX0:=DRAWLINE(LOW<=LLV(LOW,20),LOW,HIGH>=HHV(HIGH,20),LLV(LOW,4),1);
DX:IF(DX0<=RH AND DX0>=RL,DX0,DRAWNULL),LINETHICK1,COLORMAGENTA;
KX:IF(KX0<=RH AND KX0>=RL,KX0,DRAWNULL),LINETHICK1,COLORWHITE;

{DX:DRAWLINE(HIGH>=HHV(HIGH,20),HIGH,LOW<=LLV(LOW,20),HHV(HIGH,4),1),POINTDOT,COLORMAGENTA;
KX:DRAWLINE(LOW<=LLV(LOW,20),LOW,HIGH>=HHV(HIGH,20),LLV(LOW,4),1),POINTDOT,COLORWHITE;}
STICKLINE(CURRBARSCOUNT=1,G0,G0,20,5),COLORYELLOW;
STICKLINE(CURRBARSCOUNT=1,D0,D0,20,5),COLORYELLOW;
STICKLINE(CURRBARSCOUNT=1,GO0,GO0,20,5),COLORMAGENTA;
STICKLINE(CURRBARSCOUNT=1,DO0,DO0,20,5),COLORMAGENTA;
DRAWTEXT(ISLASTBAR,G0,'卖'),COLORYELLOW;
DRAWTEXT(ISLASTBAR,D0,'买'),COLORYELLOW;
DRAWTEXT(ISLASTBAR,GO0,'顶'),COLORMAGENTA;
DRAWTEXT(ISLASTBAR,DO0,'底'),COLORMAGENTA;
CC:=((HIGH+LOW+CLOSE)/3-EMA((HIGH+LOW+CLOSE)/3,5))/(0.015*AVEDEV((HIGH+LOW+CLOSE)/3,5));
STICKLINE(CC>=0,LOW,HIGH,0.0,0),COLORRED;
STICKLINE(CC>=0,CLOSE,OPEN,3,1),COLORRED;
STICKLINE(CC<0,LOW,HIGH,0.0,0),COLORGREEN;
STICKLINE(CC<0,CLOSE,OPEN,3,1),COLORGREEN;
大单动向:=(LARGEINTRDVOL-LARGEOUTTRDVOL)*10000/FINANCE(7);
涨跌动因:=IF(TRADENUM>0,(TRADEOUTNUM-TRADEINNUM)*100/TRADENUM,0);
大单差分:=IF(TRADENUM>0,(LARGETRDINNUM-LARGETRDOUTNUM)/TRADENUM*100,0);
DDZ1:=大单差分*7;
DDZ2:=大单差分*3;
主力活跃度:=LARGEINTRDVOL-LARGEOUTTRDVOL;
主力净流入:=(LARGEINTRDVOL-LARGEOUTTRDVOL)*AMO/V/10000;
买入力度:=LARGEINTRDVOL*100/VOL;
卖出力度:=LARGEOUTTRDVOL*100/VOL;
超B:=L2_AMO(0,2)/10000.0;
大B:=L2_AMO(1,2)/10000.0;
中B:=L2_AMO(2,2)/10000.0;
小B:=L2_AMO(3,2)/10000.0;
超S:=L2_AMO(0,3)/10000.0;
大S:=L2_AMO(1,3)/10000.0;
中S:=L2_AMO(2,3)/10000.0;
小S:=L2_AMO(3,3)/10000.0;
资金流向:=(超B+大B+中B+小B)-(超S+大S+中S+小S);
主力:=(超B+大B+中B)-(超S+大S+中S);
机构:=(超B+大B)-(超S+大S);
私募:=(大B+中B)-(大S+中S);
散户:=(中B+小B)-(中S+小S);
大单:=(大B)-(大S);
中单:=(中B)-(中S);
资金启动:=大单>0 AND 私募>0 AND 机构>0 AND 主力>0 AND 资金流向>0 AND 大单动向>0 AND 涨跌动因>0 AND DDZ1>0 AND DDZ2>0 AND 主力活跃度>0 AND 主力净流入>0 AND 买入力度>卖出力度;
STICKLINE(资金启动=1,LOW,HIGH,0,0),COLORRED;
STICKLINE(资金启动=1,CLOSE,OPEN,3,0),COLORRED;
STICKLINE(L<D0 AND DTD=1 AND YM>YM1,L,D0,3,0),COLORWHITE;

{========================}
{ QS量化评分 100分 }
{========================}

QS_X1:=IF(MA(C,5)>MA(C,10),20,0);
QS_X2:=IF(MA(C,20)>MA(C,60),10,0);
QS_X3:=IF(KDJ.J>KDJ.K,10,0);
QS_X4:=IF(MACD.DIF>MACD.DEA,10,0);
QS_X5:=IF(MACD.MACD>0,10,0);
QS_X6:=IF(V>MA(V,60),10,0);
QS_X7:=IF(WINNER(C)>0.5,10,0);
QS_X8:=IF(C/REF(C,1)>1.03,10,0);

QS_SCORE:=QS_X1+QS_X2+QS_X3+QS_X4+QS_X5+QS_X6+QS_X7+QS_X8;


DRAWTEXT_FIX(
    V>O,
    0.90,
    0.80,
    0,
    STRCAT(
        '量化评分:',
        STRCAT(CON2STR(QS_SCORE,0),' ')
    )
),
COLORWHITE;


{========================}
{ SR支撑反转计算 }
{========================}


SR_E:=(HIGH+LOW+OPEN+2*CLOSE)/5;


SR_RESIST:=2*SR_E-LOW;
SR_SUPPORT:=2*SR_E-HIGH;


SR_BREAK:=SR_E+(HIGH-LOW);
SR_REVERSAL:=SR_E-(HIGH-LOW);



DRAWTEXT_FIX(
    C!=0,
    0.90,
    0.88,
    0,
    STRCAT(
        '支撑:',
        STRCAT(CON2STR(SR_SUPPORT,2),' 元')
    )
),
COLORRED;



DRAWTEXT_FIX(
    C!=0,
    0.90,
    0.96,
    0,
    STRCAT(
        '反转:',
        STRCAT(CON2STR(SR_REVERSAL,2),' 元')
    )
),
COLORYELLOW;


{DRAWTEXT_FIX(ISLASTBAR,0.01,0.08,0,DYBLOCK),COLORYELLOW;}
DRAWTEXT_FIX(ISLASTBAR,0.15,0.08,0,STRCAT('行业板块:=',HYBLOCK)),COLORYELLOW;
DRAWTEXT_FIX(ISLASTBAR,0.15,0.14,0,STRCAT('概念板块:=',SUBSTR(GNBLOCK,0,48))),COLORYELLOW;


{================= SJ启动 =================}

SJ_VAR1:=(CLOSE*2+HIGH+LOW)/4;
SK:=EMA(SJ_VAR1,13)-EMA(SJ_VAR1,73);
SD:=EMA(SK,2);

SJ:=
(CROSS(SK,SD) AND SK<-0.04 AND (C-REF(C,1))/REF(C,1)>=0.03)
OR (CROSS(SK,SD) AND SK<=-0.14)
OR (CROSS(SK,SD) AND SK<=0.05
    AND (V/MA(V,5)>2 OR C/REF(C,1)>1.035));

{最后5个K线根据上涨下跌标记红色和绿色}
STICKLINE(CURRBARSCOUNT<=5 AND NOT(SJ) AND C>=O, H, L, 0, 0), COLORRED;
STICKLINE(CURRBARSCOUNT<=5 AND NOT(SJ) AND C>=O, C, O, 3, 1), COLORRED;
STICKLINE(CURRBARSCOUNT<=5 AND NOT(SJ) AND C<O, H, L, 0, 0), COLORGREEN;
STICKLINE(CURRBARSCOUNT<=5 AND NOT(SJ) AND C<O, C, O, 3, 0), COLORGREEN;


{========================================================================
  已移至底部并注释：斐波那契高低点价格与水平线（黄色价格/绿红水平线）
========================================================================}
{
T:=80;
TT:=3;
高1:=REF(HHV(H,T),TT);
低1:=REF(LLV(L,T),TT);
H1:=高1-(高1-低1)*0.191;
H2:=高1-(高1-低1)*0.382;
H3:=高1-(高1-低1)*0.5;
H4:=高1-(高1-低1)*0.618;
H5:=高1-(高1-低1)*0.809;

TT3:=(CURRBARSCOUNT=5);
TT4:=(CURRBARSCOUNT=5+3);

STICKLINE(CURRBARSCOUNT=1,高1,高1,10,5),COLORGREEN;
STICKLINE(CURRBARSCOUNT=1,低1,低1,10,5),COLORRED;
STICKLINE(CURRBARSCOUNT=1,H1,H1,10,5),COLORYELLOW;
STICKLINE(CURRBARSCOUNT=1,H2,H2,10,5),COLORMAGENTA;
STICKLINE(CURRBARSCOUNT=1,H3,H3,10,5),COLORWHITE;
STICKLINE(CURRBARSCOUNT=1,H4,H4,10,5),COLORGRAY;
STICKLINE(CURRBARSCOUNT=1,H5,H5,10,5),COLORCYAN;

DRAWNUMBER(TT3 AND 高1,高1,高1),COLORYELLOW;
DRAWTEXT(TT4 AND 高1,高1*1.01,'顶'),COLORMAGENTA;
DRAWNUMBER(TT3 AND H1,H1,H1),COLORYELLOW;
DRAWTEXT(TT4 AND H1,H1*1.01,''),COLORRED;
DRAWNUMBER(TT3 AND H2,H2,H2),COLORYELLOW;
DRAWTEXT(TT4 AND H2,H2*1.01,''),COLORRED;
DRAWNUMBER(TT3 AND H3,H3,H3),COLORYELLOW;
DRAWTEXT(TT4 AND H3,H3*1.01,'中'),COLORMAGENTA;
DRAWNUMBER(TT3 AND H4,H4,H4),COLORYELLOW;
DRAWTEXT(TT4 AND H4,H4*1.01,''),COLORRED;
DRAWNUMBER(TT3 AND H5,H5,H5),COLORYELLOW;
DRAWTEXT(TT4 AND H5,H5*1.01,''),COLORRED;
DRAWNUMBER(TT3 AND 低1,低1,低1),COLORYELLOW;
DRAWTEXT(TT4 AND 低1,低1*1.01,'底'),COLORMAGENTA;
}