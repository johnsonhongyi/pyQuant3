{
  "schema_version": 1,
  "antigravity_executable": "C:\\Users\\Johnson\\.gemini\\bin\\agy.exe",
  "codex_executable": "C:\\Users\\Johnson\\AppData\\Local\\OpenAI\\Codex\\bin\\247581e40ee272fb\\codex.exe",
  "worker_model": "gemini-3.8-flash-high",
  "worker_profile": "headless_lean",
  "worker_fallback_models": [],
  "worker_proxy": "http://127.0.0.1:7897",
  "worker_effort": "medium",
  "worker_default_count": 2,
  "worker_max_count": 3,
  "worker_timeout_seconds": 1800,
  "worker_no_activity_timeout_seconds": 300,
  "worker_suspect_timeout_seconds": 300,
  "worker_probe_timeout_seconds": 600,
  "worker_terminate_on_liveness_loss": false,
  "worker_monitor_interval_seconds": 5.0,
  "worker_heartbeat_flush_seconds": 60.0,
  "worker_log_scan_interval_seconds": 15.0,
  "worker_summary_max_chars": 200,
  "project_state_max_tokens": 500,
  "worker_stdout_max_chars": 4000,
  "worker_auto_approve_permissions": true,
  "max_auto_approve_risk": "MEDIUM",
  "permission_profiles": {
    "P0_READONLY": {
      "auto_approve": false,
      "allow_code_edit": false,
      "description": "只读审计、复核和证据整理"
    },
    "P1_DOCS_SAFE": {
      "auto_approve": true,
      "allow_code_edit": false,
      "description": "文档、Agent Hub 规则和任务书"
    },
    "P2_CODE_LOW": {
      "auto_approve": true,
      "allow_code_edit": true,
      "max_risk": "LOW",
      "description": "Files Allowed 内低风险代码与测试"
    },
    "P3_CODE_MEDIUM": {
      "auto_approve": true,
      "allow_code_edit": true,
      "max_risk": "MEDIUM",
      "description": "Files Allowed 内中风险实现，禁止实盘和密钥"
    },
    "P4_RELEASE_GATE": {
      "auto_approve": false,
      "allow_code_edit": false,
      "description": "只读发布门禁和冲突仲裁"
    },
    "P5_FORBIDDEN": {
      "auto_approve": false,
      "allow_code_edit": false,
      "description": "真实交易、密钥、自动发布和券商接口"
    }
  },
  "review_timeout_seconds": 900,
  "max_rework_cycles": 1,
  "max_review_diff_lines": 150,
  "max_review_diff_chars": 12000,
  "worker_max_readonly_tool_calls": 12,
  "worker_max_readonly_tool_calls_hard_cap": 24,
  "auto_execute": false,
  "auto_review": true,
  "auto_archive": false,
  "allowed_verification_prefixes": [
    "python -m pytest",
    "python -m compileall"
  ],
  "scope_ignore_prefixes": [
    ".agent_hub/artifacts/",
    ".agent_hub/dashboard/",
    ".agent_hub/events/",
    ".agent_hub/running/",
    ".agent_hub/done/",
    ".agent_hub/review/",
    ".agent_hub/decisions/",
    ".pytest_cache/",
    ".pytest_temp/",
    "__pycache__/",
    "logs/",
    "log/",
    "gemini.md",
    "design/antigravity_historical_tasks_archive.md",
    ".agent_hub/.worker_profile/"
  ],
  "review_profiles": {
    "task_review": {
      "model": "gpt-5.6-luna",
      "effort": "low"
    },
    "p_checkpoint_review": {
      "model": "gpt-5.6-sol",
      "effort": "medium"
    },
    "release_gate": {
      "model": "gpt-5.6-sol",
      "effort": "high"
    }
  },
  "review_quota_policy": {
    "task_review": "每个任务一次，失败仅按 max_rework_cycles 规则复审",
    "p_checkpoint_review": "仅在节点所有任务均 APPROVED 后调用一次 Medium",
    "release_gate": "仅在全部指定 P 节点通过后调用一次 High",
    "forbid_high_for_task_review": true
  },
  "hub_max_running_tasks": 3,
  "batch_default_workers": 2,
  "batch_max_workers": 3,
  "auto_checkpoint_commit": true,
  "auto_release_tag": false
}