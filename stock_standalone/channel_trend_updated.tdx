MA5:MA(CLOSE,5),COLORYELLOW,LINETHICK2;
MA10:MA(CLOSE,10),COLORYELLOW,LINETHICK2;
MA20:EMA(CLOSE,20),LINETHICK2,DOTLINE;

{==================== 神奇九转（全角大字号与上移悬浮优化） ====================}
JZ_M:=9;
JZ_N:=JZ_M-1;
JZ_OFS:=0.038; {垂直悬浮间距比例: 0.038让数字远离K线完全上移/下移，可按需微调}

JZ_UP1:=C>REF(C,4);
JZ_UP2:=BARSLASTCOUNT(JZ_UP1);
JZ_UP3:=REF(JZ_UP2,1)=JZ_N AND JZ_UP2>REF(JZ_UP2,1);
JZ_UP4:=REF(BETWEEN(JZ_UP2,5,JZ_N),1) AND JZ_UP2<REF(JZ_UP2,1);
JZ_UP5:=ISLASTBAR AND BETWEEN(JZ_UP2,6,JZ_N);

JZ_UP6:=(BACKSET(JZ_UP3>0,JZ_N+1) OR BACKSET(JZ_UP4>0,JZ_UP2+1)*0 OR BACKSET(JZ_UP5>0,JZ_UP2))*JZ_UP2;
JZ_UP_TXT:=IF(JZ_UP6=1,'１',IF(JZ_UP6=2,'２',IF(JZ_UP6=3,'３',IF(JZ_UP6=4,'４',IF(JZ_UP6=5,'５',IF(JZ_UP6=6,'６',IF(JZ_UP6=7,'７',IF(JZ_UP6=8,'８',''))))))));

{上升序列1~8采用全角大字符，位置上移至最高价上方JZ_OFS比例}
DRAWTEXT(JZ_UP6>0 AND JZ_UP6<9, H*(1+JZ_OFS), JZ_UP_TXT), COLORYELLOW;
{上升序列第9根关键转折大字符，避免重叠并突出显示}
DRAWTEXT(JZ_UP2=JZ_N+1, H*(1+JZ_OFS), ' ９ '), COLOR00FF00;

JZ_DN1:=C<REF(C,4);
JZ_DN2:=BARSLASTCOUNT(JZ_DN1);
JZ_DN3:=REF(JZ_DN2,1)=JZ_N AND JZ_DN2>REF(JZ_DN2,1);
JZ_DN4:=REF(BETWEEN(JZ_DN2,5,JZ_N),1) AND JZ_DN2<REF(JZ_DN2,1);
JZ_DN5:=ISLASTBAR AND BETWEEN(JZ_DN2,6,JZ_N);

JZ_DN6:=(BACKSET(JZ_DN3>0,JZ_N+1) OR BACKSET(JZ_DN4>0,JZ_DN2+1)*0 OR BACKSET(JZ_DN5>0,JZ_DN2))*JZ_DN2;
JZ_DN_TXT:=IF(JZ_DN6=1,'１',IF(JZ_DN6=2,'２',IF(JZ_DN6=3,'３',IF(JZ_DN6=4,'４',IF(JZ_DN6=5,'５',IF(JZ_DN6=6,'６',IF(JZ_DN6=7,'７',IF(JZ_DN6=8,'８',''))))))));

{下降序列1~8采用全角大字符，位置下移至最低价下方JZ_OFS比例}
DRAWTEXT(JZ_DN6>0 AND JZ_DN6<9, L*(1-JZ_OFS), JZ_DN_TXT), COLOR00FF00;
{下降序列第9根关键转折大字符，避免重叠并突出显示}
DRAWTEXT(JZ_DN2=JZ_N+1, L*(1-JZ_OFS), ' ９ '), COLORYELLOW;

MA250:MA(CLOSE,250),COLORGREEN,LINETHICK2;
M600:MA(CLOSE,600),COLORRED,LINETHICK1;

BL_CV:=CLOSE;
BL_N:=20;
BL_P:=2;
BOLL:MA(BL_CV,BL_N), COLORMAGENTA;
UPPER1:BOLL+BL_P*STD(BL_CV,BL_N), COLORYELLOW;
LOWER1:BOLL-BL_P*STD(BL_CV,BL_N), COLORYELLOW;

{==================== 缠论中枢计算 ====================}
N1:=10; N2:=10; DISP:=2; ZSK:=1/10;
ZSP1:=PEAK(1,ZSK*N1,1);
ZSP2:=PEAK(1,ZSK*N1,2);
ZST1:=TROUGH(2,ZSK*N2,1);
ZST2:=TROUGH(2,ZSK*N2,2);
ZSTJ1:=ZSP1>ZST1 AND ZSP2>ZST2;
ZSZD:=MAX(ZST1,ZST2);
ZSZG:=MIN(ZSP1,ZSP2);
ZSLL:=MIN(ZST1,ZST2);
ZSHH:=MAX(ZSP1,ZSP2);
ZSTJ2:=FILTER(ZSZG>ZSZD,2);
ZSTJ3:=ZSZG=REF(ZSZG,BARSLAST(ZSTJ2)) OR ZSZD=REF(ZSZD,BARSLAST(ZSTJ2));
ZSTJ4:=ZSTJ1&&ZSTJ2&&NOT(ZSTJ3);
ZSTJ5:=BETWEEN(ZSZD,REF(ZSZD,REF(BARSLAST(ZSTJ4),1)),REF(ZSZG,REF(BARSLAST(ZSTJ4),1)));
ZSTJ6:=BETWEEN(ZSZG,REF(ZSZD,REF(BARSLAST(ZSTJ4),1)),REF(ZSZG,REF(BARSLAST(ZSTJ4),1)));
ZSTJ7:=ZSZG>REF(ZSZG,REF(BARSLAST(ZSTJ4),1))&&ZSZD<REF(ZSZD,REF(BARSLAST(ZSTJ4),1));
ZSTJ8:=ZSTJ4&&NOT(ZSTJ5 OR ZSTJ6 OR ZSTJ7);

ZSZSD:=IF(ZSTJ8,ZSZD,DRAWNULL);
ZSZSG:=IF(ZSTJ8,ZSZG,DRAWNULL);
ZSZSH:=IF(ZSTJ8,ZSHH,DRAWNULL);
ZSZSL:=IF(ZSTJ8,ZSLL,DRAWNULL);

STICKLINE(ZSTJ8,ZSZSH,ZSZSL,0,-1),COLORMAGENTA;
STICKLINE(ZSTJ8,ZSZSD,ZSZSG,IF(DISP=1,3,0),1),COLORMAGENTA;
DRAWTEXT(DISP=2,ZSZSH,'中枢'),COLORRED;

中枢高:PLOYLINE(DISP=2,REF(ZSZSD,BARSLAST(ZSTJ8))),CROSSDOT,COLORLIRED;
中枢低:PLOYLINE(DISP=2,REF(ZSZSG,BARSLAST(ZSTJ8))),CROSSDOT,COLORLIGREEN;
中枢最高:PLOYLINE(DISP=2,REF(ZSZSH,BARSLAST(ZSTJ8))),POINTDOT,COLORRED;
中枢最低:PLOYLINE(DISP=2,REF(ZSZSL,BARSLAST(ZSTJ8))),POINTDOT,COLORGREEN;

{==================== 高低点价格显示 ====================}
ZS_HD1:=FILTER(BACKSET(FILTER(REF(H,10)=HHV(H,21),10),11),10);
ZS_LD1:=FILTER(BACKSET(FILTER(REF(L,10)=LLV(L,21),10),11),10);
DRAWNUMBER(ZS_HD1,H*1.03,H),COLORWHITE;
DRAWNUMBER(ZS_LD1,L*0.97,L),COLORWHITE;

{==================== DLL6 笔中枢与段中枢 ====================}
BI:=TDXDLL6(2,H,L,0);
BIZG:=TDXDLL6(5,BI,H,L);
BIZD:=TDXDLL6(7,BI,H,L);
BISE:=TDXDLL6(9,BI,H,L);
BIMID:=(BIZG-BIZD)/2+BIZD;

BIZG线:IF(BIZG,BIZG,DRAWNULL),LINETHICK3,COLORGREEN;
BIZD线:IF(BIZD,BIZD,DRAWNULL),LINETHICK3,COLORGREEN;
BI中枢:STICKLINE(BISE,BIZD,BIZG,0,0),LINETHICK3,COLORGREEN;
BIMID线:IF(BIMID,BIMID,DRAWNULL),LINETHICK2,COLORBLUE;

DUAN:=TDXDLL6(3,BI,H,L);
DUANZG:=TDXDLL6(5,DUAN,H,L);
DUANZD:=TDXDLL6(7,DUAN,H,L);
DUANSE:=TDXDLL6(9,DUAN,H,L);
DUANMID:=(DUANZG-DUANZD)/2+DUANZD;

DUANZG线:IF(DUANZG,DUANZG,DRAWNULL),LINETHICK2,COLORFF8000;
DUANZD线:IF(DUANZD,DUANZD,DRAWNULL),LINETHICK2,COLORFF8000;
DUAN中枢:STICKLINE(DUANSE,DUANZD,DUANZG,0,0),LINETHICK2,COLORFF8000;
DUANMID线:IF(DUANMID,DUANMID,DRAWNULL),LINETHICK2,COLORMAGENTA;

{==================== 右侧量化信息面板 ====================}
DRAWTEXT_FIX(ISLASTBAR,0.15,0.08,0,STRCAT('行业板块:=',HYBLOCK)),COLORYELLOW;
DRAWTEXT_FIX(ISLASTBAR,0.15,0.14,0,STRCAT('概念板块:=',SUBSTR(GNBLOCK,0,48))),COLORYELLOW;

X1:=IF(MA(C,5)>MA(C,10),20,0);
X2:=IF(MA(C,20)>MA(C,60),10,0);
X3:=IF(KDJ.J>KDJ.K,10,0);
X4:=IF(MACD.DIF>MACD.DEA,10,0);
X5:=IF(MACD.MACD>0,10,0);
X6:=IF(V>MA(V,60),10,0);
X7:=IF(WINNER(C)>0.5,10,0);
X8:=IF(C/REF(C,1)>1.03,10,0);
XX:=X1+X2+X3+X4+X5+X6+X7+X8;

DRAWTEXT_FIX(V>O,0.90,0.80,0,STRCAT('量化评分:',STRCAT(CON2STR(XX,2),' '))),COLORFFFFFF;

E:=(HIGH+LOW+OPEN+2*CLOSE)/5;
明日阻力:=2*E-LOW;
明日支撑:=2*E-HIGH;
明日突破:=E+(HIGH-LOW);
明日反转:=E-(HIGH-LOW);

DRAWTEXT_FIX(C!=0,0.90,0.88,0,STRCAT('支撑:',STRCAT(CON2STR(明日支撑,2),' 元'))),COLORRED;
DRAWTEXT_FIX(C!=0,0.90,0.96,0,STRCAT('反转:',STRCAT(CON2STR(明日反转,2),' 元'))),COLORYELLOW;

DRAWTEXT_FIX(1,0.008,0.9,0,'概念：'),COLOR99CCFF;
DRAWTEXT_FIX(1,0.07,0.9,0,GNBLOCK),COLORGREEN;

{==================== 通道与均线系统 ====================}
A:EMA(C,21)COLORGREEN,LINETHICK3;
B:=A<REF(A,1);
IF(B-1,A,DRAWNULL)COLORYELLOW,LINETHICK3;

{MA5:MA(CLOSE,5),COLORYELLOW,LINETHICK2;}
MA13:=MA(CLOSE,13),COLORCYAN,LINETHICK2;
MA60:EMA(CLOSE,60),LINETHICK2,DOTLINE,COLORCYAN;
VAR11:=MA(C,9),COLORRED;
上升通道:IF(VAR11>REF(VAR11,1),VAR11,DRAWNULL),LINETHICK2,COLORRED;
下降通道:IF(VAR11<REF(VAR11,1),VAR11,DRAWNULL),LINETHICK2,COLORGREEN;

A0:=(L+H+C*2)/4;
AA:=EMA(A0,14)COLORYELLOW,LINETHICK1;
BB:=EMA(A0,25)COLORYELLOW,LINETHICK2;
A1X:=(AA-REF(AA,1))/REF(AA,1)*100;
A2X:=(BB-REF(BB,1))/REF(BB,1)*100;
G:=BARSLAST(CROSS(A1X,0));
A5:=EMA(CLOSE,12)-EMA(CLOSE,26);
A6:=EMA(A5,9);
A7:=(A5<-0.1 AND A5>A6);
见底:IF(A7,LLV(L,21),DRAWNULL)COLORRED,CIRCLEDOT;
见顶:IF(H>=REF(A0,BARSLAST(CROSS(A1X,0)))*1.3,REF(A0,BARSLAST(CROSS(A1X,0)))*1.3,DRAWNULL),COLORGREEN,CIRCLEDOT;

N:=8; M:=3;
高:=REF(HHV(H,N),M); 
低:=REF(LLV(L,N),M);
H19:=高-(高-低)*0.191; 
H38:=高-(高-低)*0.382; 
H中:=高-(高-低)*0.5; 
H61:=高-(高-低)*0.618; 
H80:=高-(高-低)*0.809;

STICKLINE(CURRBARSCOUNT=1,高,高,30,5),COLORGREEN;
STICKLINE(CURRBARSCOUNT=1,低,低,30,5),COLORRED;
STICKLINE(CURRBARSCOUNT=1,H19,H19,30,5),COLORYELLOW;
STICKLINE(CURRBARSCOUNT=1,H38,H38,30,5),COLORMAGENTA;
STICKLINE(CURRBARSCOUNT=1,H中,H中,30,5),COLORWHITE;
STICKLINE(CURRBARSCOUNT=1,H61,H61,30,5),COLORGRAY;
STICKLINE(CURRBARSCOUNT=1,H80,H80,30,5),COLORCYAN;

{==================== MACD 与形态变色 K 线 ====================}
DIFF:=( EMA(CLOSE,7) - EMA(CLOSE,19)); 
DEA:=EMA(DIFF,9); 
TJ:=(DIFF>=DEA); 
TJ1:=(DIFF>=0); 
STICKLINE(TJ,H,L,0.4,0),COLORYELLOW; 
STICKLINE(TJ,O,C,4,1),COLOR0088FF; 
STICKLINE(TJ,O,C,3.4,1),COLOR00AAFF; 
STICKLINE(TJ,O,C,2.8,1),COLOR00CCFF; 
STICKLINE(TJ,O,C,2,1),COLOR00DDFF; 
STICKLINE(TJ,O,C,1.2,1),COLOR55FFFF; 
STICKLINE(TJ,O,C,0.4,1),COLOR99FFFF; 
STICKLINE(TJ1 AND TJ,H,L,0.4,0),COLORF00FF0; 
STICKLINE(TJ1 AND TJ,O,C,4,1),COLORFF33FF; 
STICKLINE(TJ1 AND TJ,O,C,3.4,1),COLORFF55FF; 
STICKLINE(TJ1 AND TJ,O,C,2.8,1),COLORFF77FF; 
STICKLINE(TJ1 AND TJ,O,C,2,1),COLORFF99FF; 
STICKLINE(TJ1 AND TJ,O,C,1.2,1),COLORFFBBFF; 
STICKLINE(TJ1 AND TJ,O,C,0.4,1),COLORFFDDFF; 
STICKLINE(DIFF<DEA,H,L,0.4,0),COLORF0F000; 
STICKLINE(DIFF<DEA,O,C,4,1),COLORFF3300; 
STICKLINE(DIFF<DEA,O,C,3.4,1),COLORFF6600; 
STICKLINE(DIFF<DEA,O,C,2.8,1),COLORFF9900; 
STICKLINE(DIFF<DEA,O,C,2,1),COLORFFBB00; 
STICKLINE(DIFF<DEA,O,C,1.2,1),COLORFFDD00; 
STICKLINE(DIFF<DEA,O,C,0.4,1),COLORFFFF00; 

VAR1:=(CLOSE*2+HIGH+LOW)/4; 
SK:= EMA(VAR1,13)-EMA(VAR1,73); 
SD:= EMA(SK,2); 
SJ:=(CROSS(SK,SD) AND SK<-0.04 AND (C-REF(C,1))/REF(C,1)>=0.03)OR(CROSS(SK,SD) AND SK<=-0.14)OR(CROSS(SK,SD) AND SK<=0.05 AND (V/MA(V,5)>2 OR C/REF(C,1)>0.035)); 
STICKLINE(SJ,H,L,0.5,0),COLORRED; 
STICKLINE(SJ,O,C,5.5,0),LINETHICK3,COLOR000055; 
STICKLINE(SJ,O,C,4.5,0),LINETHICK3,COLOR000077; 
STICKLINE(SJ,O,C,3.5,0),LINETHICK3,COLOR000099; 
STICKLINE(SJ,O,C,2.5,0),LINETHICK3,COLOR0000BB; 
STICKLINE(SJ,O,C,1.5,0),LINETHICK3,COLOR0000DD; 
STICKLINE(SJ,O,C,0.5,0),LINETHICK3,COLOR0000FF; 

LC:=REF(CLOSE,1);
RSI:=SMA(MAX(CLOSE-LC,0),6,1)/SMA(ABS(CLOSE-LC),6,1)*100;
DRAWTEXT(CROSS(84,RSI), HIGH,'←-----逃'),COLORGREEN;
VAR3AA:=IF((CLOSE>REF(CLOSE,1)),88,0);
VAR4AA:=IF(((CLOSE)/(REF(CLOSE,1))>1.05) AND ((HIGH)/(CLOSE)<1.01) AND (VAR3AA>0),91,0);
DRAWTEXT(FILTER((VAR4AA>90),45),(LOW)*(0.93),'←---大胆搏 '),COLORYELLOW;
VAR51:=3;
VAR52:=(3)*(SMA(((CLOSE - LLV(LOW,27))/(HHV(HIGH,27) - LLV(LOW,27)))*(100),5,1)) - (2)*(SMA(SMA(((CLOSE - LLV(LOW,27))/(HHV(HIGH,27) - LLV(LOW,27)))*(100),5,1),3,1));
DRAWTEXT(CROSS(VAR52,VAR51), LOW,'←启动'),COLORMAGENTA;

{==================== 自动通道计算 ====================}
UR:=6; LR:=6;
TC1:=IF(H=HHV(H,6*UR),H,DRAWNULL);
TC2:=CONST(BARSLAST(TC1=H))+1;
UPPER:=CONST(IF(TC2=1,H,REF(H,TC2-1)));
BC1:=IF(L=LLV(L,6*LR),L,DRAWNULL);
BC2:=CONST(BARSLAST(BC1=L))+1;
LOWER:=CONST(IF(BC2=1,L,REF(L,BC2-1)));
LP:=CURRBARSCOUNT<=BC2 AND L=LOWER;
HP:=CURRBARSCOUNT<=TC2 AND H=UPPER;
STICKLINE(IF(BC2>TC2,HP,LP),LOWER,UPPER,0,0),COLOR00FFFF;
STICKLINE(IF(BC2>TC2,LP,HP),LOWER,UPPER,0,0),COLOR00FFFF;

NOD:=(IF(TC2>BC2,TC2,BC2)-IF(TC2>BC2,BC2,TC2));
LR1:=FORCAST(C,NOD+1);
NP:IF(CURRBARSCOUNT<=MAX(BC2,TC2),CONST(IF(MIN(TC2,BC2)=1,LR1,REF(LR1,MIN(TC2,BC2)-1))),DRAWNULL),COLORGREEN,LINETHICK1;
LR2:=SLOPE(C,NOD+1);
LR3:=CONST(IF(MIN(TC2,BC2)=1,LR2,REF(LR2,MIN(TC2,BC2)-1)));
FP:NP-LR3*(NOD),COLORRED;
EQU:(NP+FP)/2,COLOR93BDA8;

AD:=ABS(NP-FP);
DBL:=BARSLAST(BC1!=DRAWNULL)+1;
DBH:=BARSLAST(TC1!=DRAWNULL)+1;
BSP:=IF(BC2>TC2,DBL,DBH)-1;

LRL:=IF(NP>FP,FP+AD/NOD*BSP,FP-AD/NOD*BSP);
AT1:=IF(BETWEEN(CURRBARSCOUNT,BC2,TC2) AND H>LRL,H,LRL);
AT2:=HHV(AT1-LRL,MAX(BC2,TC2));
AT3:=CONST(BARSLAST(AT1-LRL=AT2));
AT5:=CONST(IF(AT3=0,AT1-LRL,REF(AT1-LRL,AT3)));
UT1:=IF(BETWEEN(CURRBARSCOUNT,BC2,TC2) AND L<LRL,L,LRL);
UT2:=HHV(LRL-UT1,MAX(BC2,TC2));
UT3:=CONST(BARSLAST(LRL-UT1=UT2));
UT5:=CONST(IF(UT3=0,LRL-UT1,REF(LRL-UT1,UT3)));

最高限制:=HHV(H,100)*1.10;
最低限制:=LLV(L,100)*0.90;
K:=CONST(LR3);
START:=MIN(TC2,BC2);
MID:=CONST(REF(LRL,START-1))-K*(CURRBARSCOUNT-START);
UP:=MID+CONST(AT5);
DN:=MID-CONST(UT5);

中轨:IF(CURRBARSCOUNT<=MAX(BC2,TC2) AND MID>=最低限制 AND MID<=最高限制, MID, DRAWNULL), COLORWHITE,LINETHICK2;
上轨:IF(CURRBARSCOUNT<=MAX(BC2,TC2), MIN(MAX(UP,最低限制),最高限制), DRAWNULL), COLORWHITE,LINETHICK1;
下轨:IF(CURRBARSCOUNT<=MAX(BC2,TC2), MIN(MAX(DN,最低限制),最高限制), DRAWNULL), COLORWHITE,LINETHICK1;

STICKLINE(CURRBARSCOUNT<=5 AND NOT(SJ) AND C>=O, H, L, 0, 0), COLORRED;
STICKLINE(CURRBARSCOUNT<=5 AND NOT(SJ) AND C>=O, C, O, 3, 1), COLORRED;
STICKLINE(CURRBARSCOUNT<=5 AND NOT(SJ) AND C<O, H, L, 0, 0), COLORGREEN;
STICKLINE(CURRBARSCOUNT<=5 AND NOT(SJ) AND C<O, C, O, 3, 0), COLORGREEN;

KX_RAW:=DRAWLINE(LOW<=LLV(LOW,20), LOW, HIGH>=HHV(HIGH,20), LLV(LOW,4), 1);
KX:IF(BETWEEN(KX_RAW,最低限制,最高限制), KX_RAW, DRAWNULL), COLORWHITE,LINETHICK1;

{==================== 逆势先锋金色垂直虚线 (极简无冗余整合) ====================}
NX_MAX:=MAX(MAX(MA(C,5),MA(C,10)),MA(C,20));
NX_MIN:=MIN(MIN(MA(C,5),MA(C,10)),MA(C,20));
NX_SIG:=FILTER((NX_MAX-NX_MIN)/C<=0.05 AND LLV(L,5)>=LLV(L,20)*0.985 AND V>=MA(V,5)*1.3 AND C>=REF(HHV(H,10),1)*0.985 AND C>NX_MAX AND (C-REF(C,1))/REF(C,1)>=0.028, 5);

STICKLINE(NX_SIG, 最低限制, 最高限制, 0, -1), COLORGREEN;
DRAWTEXT(NX_SIG, 最高限制*0.98, ' ┆逆势先锋'), COLORGREEN;